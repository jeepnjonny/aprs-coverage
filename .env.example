# Copy to .env and edit. On the server this lives at /srv/aprs-coverage/.env

# Login name for APRS-IS. Read-only (passcode -1), so nothing is ever sent.
# Use your callsign with an SSID that no other station uses.
APRS_LOGIN=K7SWI-CV
APRS_SERVER=noam.aprs2.net
APRS_PORT=14580
APRS_ENABLED=1

# SQLite database file
DB_PATH=/srv/aprs-coverage/data/coverage.sqlite

# Grid reference latitude (sets the longitude width of a square). Changing it
# moves every square boundary, so pick it once.
GRID_REF_LAT=43.6

# Data-quality filters
MAX_SPEED_KMH=250
DUPLICATE_WINDOW_S=30
# Optional: reject positions outside min_lat,min_lon,max_lat,max_lon
# REGION_BBOX=41.9,-117.3,45.0,-114.5

# Set to 0 only for local http:// testing
COOKIE_SECURE=1
SESSION_DAYS=30
